<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Jellyfin.Plugin.SeasonSubtitles</RootNamespace>
        <AssemblyName>Jellyfin.Plugin.SeasonSubtitles</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
        <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="Web\season-subtitles.js" />
        <EmbeddedResource Include="Web\season-subtitles.js" />
        <None Remove="Configuration\configPage.html" />
        <EmbeddedResource Include="Configuration\configPage.html" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="tests\**" />
        <EmbeddedResource Remove="tests\**" />
        <None Remove="tests\**" />
    </ItemGroup>
</Project>
